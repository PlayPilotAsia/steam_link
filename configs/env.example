# configs/{local,test,prod}.env 的模板。
#
# 复制一份改名后填值：
#   cp configs/env.example configs/test.env
#
# 这三个 .env 文件已被 .gitignore 排除，不会进仓库；本模板会。
# 因此模板里只能写占位符，不要填真实地址或密钥。
#
# 加载规则（见 internal/config/envfile.go）：
#   - 仅补齐进程环境中尚不存在的键，真实环境变量永远优先
#   - 文件不存在不报错，生产可以只靠容器环境变量
#   - 值含空格或 # 时用引号包起来

# ---- Steam ----
STEAMLINK_STEAM_API_KEY=

# ---- MySQL ----
# local: 127.0.0.1（本机 docker）
# test:  阿里云实例的公网 IP
# prod:  阿里云实例的内网 IP
STEAMLINK_MYSQL_HOST=
STEAMLINK_MYSQL_PORT=3306
STEAMLINK_MYSQL_USER=
STEAMLINK_MYSQL_PASSWORD=
STEAMLINK_MYSQL_DATABASE=steamlink

# ---- Redis ----
# 形如 host:port，同样是 test 用公网、prod 用内网
STEAMLINK_REDIS_ADDR=
STEAMLINK_REDIS_PASSWORD=
STEAMLINK_REDIS_DB=0

# ---- 本站会话 ----
# 随机串，用于签名 OpenID 回调的 CSRF state：openssl rand -hex 32
STEAMLINK_AUTH_STATE_SECRET=

# ---- 仅 prod 必填 ----
# 站点根地址，必须是 https，且是「用户浏览器」访问得到的域名
# STEAMLINK_HTTP_BASE_URL=https://example.com
